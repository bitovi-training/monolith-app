{
  "preset": "ts-jest",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "(\\.e2e-spec\\.ts$|test/api/.*\\.spec\\.ts$)",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": false,
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node",
          "resolvePackageJsonExports": false,
          "types": ["jest", "node"]
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(uuid)/)"
  ],
  "globals": {
    "ts-jest": {
      "tsconfig": "./test/tsconfig.json"
    }
  }
}
